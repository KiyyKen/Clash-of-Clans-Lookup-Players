{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/player/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/players/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/clan/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/clans/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
